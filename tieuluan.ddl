CREATE TABLE StaffAccount (staffId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, email varchar(255) NOT NULL, passwordHash varchar(255) NOT NULL, status varchar(255) NOT NULL, fullName varchar(255) NOT NULL, roleName varchar(255) NOT NULL);
CREATE TABLE Product (productId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, name varchar(255) NOT NULL, category varchar(255) NOT NULL, description varchar(255) NOT NULL, published integer(10) NOT NULL, publisherStaffId integer(10), StaffAccountstaffId integer(10), ProductId integer(10), LightRequirement varchar(255), WateringFrequency varchar(255), CareLevel varchar(255), ExpectedHeightCm integer(10), FOREIGN KEY(publisherStaffId) REFERENCES StaffAccount(staffId), FOREIGN KEY(StaffAccountstaffId) REFERENCES StaffAccount(staffId));
CREATE TABLE ProductVariant (variantId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, ProductproductId4 integer(10) NOT NULL, ProductProductproductId integer(10), ProductproductId integer(10) NOT NULL, ProductProductId integer(10), sku varchar(255) NOT NULL, sizeLabel varchar(255) NOT NULL, optionLabel varchar(255) NOT NULL, priceCents integer(10) NOT NULL, saleStatus varchar(255) NOT NULL, productId integer(10) NOT NULL, ProductproductId2 integer(10) NOT NULL, ProductproductId3 integer(10) NOT NULL, FOREIGN KEY(productId) REFERENCES Product(productId), FOREIGN KEY(ProductproductId) REFERENCES Product(productId), FOREIGN KEY(ProductproductId4) REFERENCES Product(productId));
CREATE TABLE ProductImage (imageId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, ProductVariantvariantId integer(10) NOT NULL, imageUrl varchar(255) NOT NULL, sortOrder integer(10) NOT NULL, approved integer(10) NOT NULL, variantId integer(10) NOT NULL, FOREIGN KEY(variantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(ProductVariantvariantId) REFERENCES ProductVariant(variantId));
CREATE TABLE CareGuide (guideId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, ProductproductId integer(10), ProductProductproductId integer(10), categoryScope varchar(255), title varchar(255) NOT NULL, content varchar(255) NOT NULL, sourceTitle varchar(255) NOT NULL, approved integer(10) NOT NULL, revisionDate varchar(255) NOT NULL, plantProductId integer(10), PlantProductProductProductproductId integer(10) NOT NULL, PlantProductProductproductId integer(10) NOT NULL, PlantProductProductProductproductId2 integer(10), PlantProductProductproductId2 integer(10), FOREIGN KEY(PlantProductProductProductproductId, PlantProductProductproductId) REFERENCES PlantProduct(ProductProductproductId, ProductproductId), FOREIGN KEY(PlantProductProductProductproductId2, PlantProductProductproductId2) REFERENCES PlantProduct(ProductProductproductId, ProductproductId));
CREATE TABLE Customer (customerId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, email varchar(255) NOT NULL, passwordHash varchar(255) NOT NULL, status varchar(255) NOT NULL, fullName varchar(255) NOT NULL, phone varchar(255) NOT NULL, defaultAddress varchar(255) NOT NULL, lightLevel varchar(255), spaceCm integer(10), careEffort varchar(255));
CREATE TABLE Cart (cartId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, CustomercustomerId2 integer(10), CustomercustomerId integer(10), sessionKey varchar(255) NOT NULL, createdAt varchar(255) NOT NULL, updatedAt varchar(255) NOT NULL, customerId integer(10), FOREIGN KEY(customerId) REFERENCES Customer(customerId), FOREIGN KEY(CustomercustomerId) REFERENCES Customer(customerId), FOREIGN KEY(CustomercustomerId2) REFERENCES Customer(customerId));
CREATE TABLE CartItem (cartItemId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, CartcartId2 integer(10) NOT NULL, ProductVariantvariantId2 integer(10) NOT NULL, CartcartId integer(10) NOT NULL, ProductVariantvariantId integer(10) NOT NULL, quantity integer(10) NOT NULL, cartId integer(10) NOT NULL, variantId integer(10) NOT NULL, FOREIGN KEY(cartId) REFERENCES Cart(cartId), FOREIGN KEY(variantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(ProductVariantvariantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(CartcartId) REFERENCES Cart(cartId), FOREIGN KEY(ProductVariantvariantId2) REFERENCES ProductVariant(variantId), FOREIGN KEY(CartcartId2) REFERENCES Cart(cartId));
CREATE TABLE PlantProduct (ProductProductproductId integer(10) NOT NULL, ProductId integer(10) NOT NULL, LightRequirement varchar(255) NOT NULL, WateringFrequency varchar(255) NOT NULL, CareLevel varchar(255) NOT NULL, ExpectedHeightCm integer(10) NOT NULL, ProductproductId integer(10) NOT NULL, PRIMARY KEY (ProductProductproductId, ProductproductId), FOREIGN KEY() REFERENCES Product(), FOREIGN KEY(ProductproductId) REFERENCES Product(productId));
CREATE TABLE AccessoryProduct (ProductProductproductId integer(10) NOT NULL, ProductId integer(10) NOT NULL, AccessoryType varchar(255) NOT NULL, Material varchar(255) NOT NULL, UsageInstructions varchar(255) NOT NULL, ProductproductId integer(10) NOT NULL, PRIMARY KEY (ProductProductproductId, ProductproductId), FOREIGN KEY() REFERENCES Product(), FOREIGN KEY(ProductproductId) REFERENCES Product(productId));
CREATE TABLE Supplier (supplierId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, supplierName varchar(255) NOT NULL, contactName varchar(255) NOT NULL, phone varchar(255) NOT NULL, email varchar(255) NOT NULL);
CREATE TABLE InventoryBatch (batchId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, ProductVariantvariantId2 integer(10) NOT NULL, StaffAccountstaffId integer(10) NOT NULL, ProductVariantvariantId integer(10) NOT NULL, SuppliersupplierId integer(10) NOT NULL, supplierBatchRef varchar(255) NOT NULL, arrivalDate varchar(255) NOT NULL, receivedQty integer(10) NOT NULL, supplierDocumentQty integer(10), readyQty integer(10) NOT NULL, reservedQty integer(10) NOT NULL, allocatedQty integer(10) NOT NULL, underCareQty integer(10) NOT NULL, removedQty integer(10) NOT NULL, dispatchedQty integer(10) NOT NULL, postedAt varchar(255), receiverStaffId integer(10) NOT NULL, supplierId integer(10) NOT NULL, variantId integer(10) NOT NULL, FOREIGN KEY(receiverStaffId) REFERENCES StaffAccount(staffId), FOREIGN KEY(supplierId) REFERENCES Supplier(supplierId), FOREIGN KEY(variantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(SuppliersupplierId) REFERENCES Supplier(supplierId), FOREIGN KEY(ProductVariantvariantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(StaffAccountstaffId) REFERENCES StaffAccount(staffId), FOREIGN KEY(ProductVariantvariantId2) REFERENCES ProductVariant(variantId));
CREATE TABLE InspectionRecord (inspectionId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, InventoryBatchbatchId integer(10) NOT NULL, StaffAccountstaffId integer(10) NOT NULL, recordType varchar(255) NOT NULL, recordedAt varchar(255) NOT NULL, conditionSummary varchar(255) NOT NULL, careNote varchar(255), readyQty integer(10) NOT NULL, underCareQty integer(10) NOT NULL, removedQty integer(10) NOT NULL, reinspectionDate varchar(255), inspectorStaffId integer(10) NOT NULL, batchId integer(10) NOT NULL, FOREIGN KEY(inspectorStaffId) REFERENCES StaffAccount(staffId), FOREIGN KEY(batchId) REFERENCES InventoryBatch(batchId), FOREIGN KEY(StaffAccountstaffId) REFERENCES StaffAccount(staffId), FOREIGN KEY(InventoryBatchbatchId) REFERENCES InventoryBatch(batchId));
CREATE TABLE StockReservation (reservationId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, CustomercustomerId2 integer(10) NOT NULL, CartcartId2 integer(10) NOT NULL, CustomercustomerId integer(10) NOT NULL, CartcartId integer(10) NOT NULL, checkoutRef varchar(255) NOT NULL, receiverName varchar(255) NOT NULL, receiverPhone varchar(255) NOT NULL, deliveryAddress varchar(255) NOT NULL, deliveryOption varchar(255) NOT NULL, shippingFeeCents integer(10) NOT NULL, totalCents integer(10) NOT NULL, currency varchar(255) NOT NULL, status varchar(255) NOT NULL, createdAt varchar(255) NOT NULL, expiresAt varchar(255) NOT NULL, cartId integer(10) NOT NULL, customerId integer(10) NOT NULL, FOREIGN KEY(cartId) REFERENCES Cart(cartId), FOREIGN KEY(customerId) REFERENCES Customer(customerId), FOREIGN KEY(CartcartId) REFERENCES Cart(cartId), FOREIGN KEY(CustomercustomerId) REFERENCES Customer(customerId), FOREIGN KEY(CartcartId2) REFERENCES Cart(cartId), FOREIGN KEY(CustomercustomerId2) REFERENCES Customer(customerId));
CREATE TABLE ReservationItem (reservationItemId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, StockReservationreservationId2 integer(10) NOT NULL, InventoryBatchbatchId2 integer(10) NOT NULL, StockReservationreservationId integer(10) NOT NULL, InventoryBatchbatchId integer(10) NOT NULL, quantity integer(10) NOT NULL, unitPriceCents integer(10) NOT NULL, reservationId integer(10) NOT NULL, batchId integer(10) NOT NULL, FOREIGN KEY(reservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(batchId) REFERENCES InventoryBatch(batchId), FOREIGN KEY(InventoryBatchbatchId) REFERENCES InventoryBatch(batchId), FOREIGN KEY(StockReservationreservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(InventoryBatchbatchId2) REFERENCES InventoryBatch(batchId), FOREIGN KEY(StockReservationreservationId2) REFERENCES StockReservation(reservationId));
CREATE TABLE ShipmentEvent (eventId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, ShipmentshipmentId integer(10) NOT NULL, providerEventRef varchar(255) NOT NULL, eventStatus varchar(255) NOT NULL, occurredAt varchar(255) NOT NULL, shipmentId integer(10) NOT NULL, FOREIGN KEY(shipmentId) REFERENCES Shipment(shipmentId), FOREIGN KEY(ShipmentshipmentId) REFERENCES Shipment(shipmentId));
CREATE TABLE Shipment (shipmentId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, CustomerOrderorderId integer(10) NOT NULL, trackingRef varchar(255), carrierName varchar(255), handlingInstructions varchar(255) NOT NULL, dispatchChecklistCompleted integer(10) NOT NULL, dispatchCheckNote varchar(255), status varchar(255) NOT NULL, dispatchedAt varchar(255), orderId integer(10) NOT NULL, FOREIGN KEY(orderId) REFERENCES CustomerOrder(orderId), FOREIGN KEY(CustomerOrderorderId) REFERENCES CustomerOrder(orderId));
CREATE TABLE CustomerOrder (orderId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, StockReservationreservationId2 integer(10) NOT NULL, CustomercustomerId2 integer(10) NOT NULL, CustomercustomerId integer(10) NOT NULL, StockReservationreservationId integer(10) NOT NULL, orderRef varchar(255) NOT NULL, receiverName varchar(255) NOT NULL, receiverPhone varchar(255) NOT NULL, deliveryAddress varchar(255) NOT NULL, deliveryOption varchar(255) NOT NULL, shippingFeeCents integer(10) NOT NULL, status varchar(255) NOT NULL, totalCents integer(10) NOT NULL, currency varchar(255) NOT NULL, createdAt varchar(255) NOT NULL, paidAt varchar(255), cancellationReason varchar(255), customerId integer(10) NOT NULL, reservationId integer(10) NOT NULL, FOREIGN KEY(customerId) REFERENCES Customer(customerId), FOREIGN KEY(reservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(StockReservationreservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(CustomercustomerId) REFERENCES Customer(customerId), FOREIGN KEY(CustomercustomerId2) REFERENCES Customer(customerId), FOREIGN KEY(StockReservationreservationId2) REFERENCES StockReservation(reservationId));
CREATE TABLE OrderLine (orderLineId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, InventoryBatchbatchId2 integer(10) NOT NULL, ProductVariantvariantId2 integer(10) NOT NULL, CustomerOrderorderId2 integer(10) NOT NULL, InventoryBatchbatchId integer(10) NOT NULL, CustomerOrderorderId integer(10) NOT NULL, ProductVariantvariantId integer(10) NOT NULL, skuSnapshot varchar(255) NOT NULL, nameSnapshot varchar(255) NOT NULL, quantity integer(10) NOT NULL, unitPriceCents integer(10) NOT NULL, orderId integer(10) NOT NULL, variantId integer(10) NOT NULL, batchId integer(10) NOT NULL, FOREIGN KEY(orderId) REFERENCES CustomerOrder(orderId), FOREIGN KEY(variantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(batchId) REFERENCES InventoryBatch(batchId), FOREIGN KEY(ProductVariantvariantId) REFERENCES ProductVariant(variantId), FOREIGN KEY(CustomerOrderorderId) REFERENCES CustomerOrder(orderId), FOREIGN KEY(InventoryBatchbatchId) REFERENCES InventoryBatch(batchId), FOREIGN KEY(CustomerOrderorderId2) REFERENCES CustomerOrder(orderId), FOREIGN KEY(ProductVariantvariantId2) REFERENCES ProductVariant(variantId), FOREIGN KEY(InventoryBatchbatchId2) REFERENCES InventoryBatch(batchId));
CREATE TABLE PaymentTransaction (paymentId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, CustomerOrderorderId2 integer(10), StockReservationreservationId2 integer(10) NOT NULL, CustomerOrderorderId integer(10), StockReservationreservationId integer(10) NOT NULL, providerTransactionId varchar(255), paymentMethod varchar(255) NOT NULL, amountCents integer(10) NOT NULL, currency varchar(255) NOT NULL, status varchar(255) NOT NULL, receivedAt varchar(255), reservationId integer(10) NOT NULL, orderId integer(10), FOREIGN KEY(reservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(orderId) REFERENCES CustomerOrder(orderId), FOREIGN KEY(StockReservationreservationId) REFERENCES StockReservation(reservationId), FOREIGN KEY(CustomerOrderorderId) REFERENCES CustomerOrder(orderId), FOREIGN KEY(StockReservationreservationId2) REFERENCES StockReservation(reservationId), FOREIGN KEY(CustomerOrderorderId2) REFERENCES CustomerOrder(orderId));
